# Example backend environment. Copy to backend/.env for local dev, or mirror these keys into the
# host dashboard (Render Environment tab) for production. NEVER commit real secrets — only this
# placeholder file is git-tracked (see .gitignore: !.env.example).

# --- Required (the app will not boot if these three are missing) ---
MONGO_URL=mongodb+srv://<user>:<urlencoded-password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Host-run backend against the replica-set MongoDB from `docker compose up mongo mongo-init-replica`:
# MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
DB_NAME=tripsplitter
JWT_SECRET=<long-random-string>

# --- Fixed application admin: jyotirmaysingh03@gmail.com (seeded only when missing) ---
ADMIN_PASSWORD=<password>

# --- Transactional email: backend-only EmailJS. Keep disabled until all provider security
#     checks in docs/EMAIL_SETUP.md pass. Disabled delivery never verifies an account.
APP_NAME=
APP_URL=
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAIL_FEATURES_ENABLED=false

# --- Google Sign-In: one client id, or a comma-separated list of accepted audiences ---
GOOGLE_CLIENT_ID=<web-client-id>,<ios-client-id>

# --- Android push notifications (Expo Push Service -> FCM v1). Keep disabled until the Android
#     Firebase app, EAS FCM v1 credential, and Expo enhanced-push access token are configured. ---
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=<expo-enhanced-push-access-token>

# --- Multi-currency expenses (Frankfurter v2; no provider API key required). Keep false until the
#     compatible frontend has been deployed, then enable without rebuilding the app. ---
MULTI_CURRENCY_EXPENSES_ENABLED=false
# Expense coverage foundation only; activation and payment workflows are later-session gates.
EXPENSE_SETTLEMENT_ENABLED=false
