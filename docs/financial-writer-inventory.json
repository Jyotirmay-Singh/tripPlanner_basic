{
  "schema_version": 2,
  "reviewed_date": "2026-10-06",
  "policies": {
    "reviewed_money": "Protected groups delegate to snapshot-transaction settlement intents/corrections; old contracts fail before effects. Unprotected legacy behavior remains.",
    "reviewed_expense": "Protected creation saves authoritative revisions; financial changes use correction plans; harmless metadata delegates to its transactional service. Legacy branch is unprotected only.",
    "reviewed_roster": "Protected roster/access mutations use reviewed corrections, current owner/admin authority and gross departure checks; stable historical IDs survive. Legacy payloads are blocked.",
    "guarded_identity": "Protected join/claim/clean-stub/join-approval writers are blocked. Use the reviewed link_person/add_member workflow instead; no automatic identity substitution.",
    "request_only": "Join requests and invites do not grant membership or financial authority; protected final linking is blocked or reviewed.",
    "recipient_binding": "Protected recipient-profile changes require snapshot transactions, monotonic recipient revision, durable binding invalidation and trip version; reported evidence remains.",
    "mobile_claim": "Protected mobile claim/profile changes use required transactions; startup claim repair excludes protected groups. Optional/compensated fallback applies only to unprotected claims.",
    "departure": "Protected leave delegates to reviewed corrections. Account deletion requires reviewed departures first; legacy destructive cleanup excludes protected financial rows/evidence.",
    "receipt": "Protected receipt writes stage immutable blobs and transactionally switch versioned pointers. Destructive replacement/cascade is allowed only for unprotected groups.",
    "journal": "Required snapshot transactions conserve complete bundles and source claims; immutable revisions/events/reversals, current authority, durable mutation receipts and trip versions. No cash is invented.",
    "correction": "Reviewed preview/proposal/action and compensation service; snapshot transactions reload authority/dependencies and commit evidence, status, mutation receipt, trip version and notification together.",
    "reconciliation": "Explicit reviewed conserving allocation of existing credit/offset; no new cash or consent inference; current admin and plan hash required.",
    "historical_migration": "Explicit-target reviewed staging/final snapshot transaction; dry-run by default, accepted hash/actor/reason required; separate authorization for reads/index installation/application/activation.",
    "legacy_migration": "Whole-unit/income/reallocation writers reject protected trip markers. Use explicit reviewed historical or financial corrections instead.",
    "binding_invalidation": "Called within the owning financial transaction; cancel only entirely unreported work, retain reported/confirmed work, append action and outbox event.",
    "lifecycle": "Protected intent expiry/recovery uses required snapshot transactions, trip revisions and audit/outbox. Reported evidence does not expire; legacy sweep excludes protected unreported attempts.",
    "indexes": "Default additive prerequisite creation. Never drop incompatible UPI quote indexes automatically; the opt-in compatibility upgrade requires separate reviewed authorization. The v2 installer is explicit and not called at startup.",
    "metadata": "Group display/budget/date or activity metadata cannot change currency, people or financial allocations. Current route permission checks apply; no coverage mutation.",
    "new_group": "Creates a new unactivated group only; no existing accounting evidence is changed.",
    "startup": "Protected groups are excluded from financial/roster/admin/identity legacy backfills. Display/activity/auth housekeeping is harmless. Operator-role promotion serializes on the user document, as do final financial approvals. No v2 upgrade or activation runs at startup.",
    "audit": "Append-only audit/normalization evidence invoked by the owning route or transaction. Never changes financial allocation or cash.",
    "outbox": "Notification/device delivery state only; financial callers enqueue inside their transaction. Current access is rechecked before delivery; no payment evidence in notification text.",
    "auth": "Account authentication/credential maintenance only; no trip person reassignment or receipt/allocation mutation. Account role changes serialize on the user record with final approvals.",
    "chat": "Chat text/read counters/tombstones only; no financial or roster state.",
    "fx": "Rate cache and unused quote evidence only; cannot reconvert saved expenses or confirm cash. Approved expense conversion goes through the financial writer.",
    "probe": "Transaction-capability probe in an isolated collection; no ledger data or group activation."
  },
