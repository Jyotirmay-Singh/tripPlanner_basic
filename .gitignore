# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Local dev server logs (e.g. uvicorn/expo output captured during local test runs)
.uvicorn.*.log
uvicorn.*.log
expo.*.log
*uvicorn*.log
.expo-web*.log
_run_*.log

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)
.env
.env.*
*.env
!.env.example
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac
.playwright-mcp/
.tokensave/

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/archive.zip
archive.zip
# Local release evidence and the consolidated Play Store handoff (documents,
# listing-asset copies, private reviewer access and recovery notes).
.release-tmp/

# Private account handoffs must stay local even if copied outside .release-tmp.
QA_ACCOUNTS.md
REVIEWER_ACCESS_PRIVATE.md

# Local Firebase configuration and signing material. Existing checked-in Android
# debug-keystore templates are retained for native-project compatibility; this
# rule prevents adding new signing files and does not rotate/remove existing keys.
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Generated Android binaries belong in release assets, not source control.
*.apk
*.aab
*.apks
*.idsig

# Generated runtime/browser/build logs and local test caches/reports.
*.log
.pytest_cache/
/test_reports/**/*.json
/test_reports/**/*.xml
/test_reports/**/*.html
/test_reports/**/*.png
/test_reports/**/*.webm
/test_reports/**/*.mp4
